{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Santra",
  "mainBinaryName": "santra",
  "version": "0.1.0",
  "identifier": "io.santra.app",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5173 --strictPort",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "workspace",
        "title": "Santra",
        "url": "index.html",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 620
      },
      {
        "label": "wheel",
        "title": "Santra wheel",
        "url": "index.html?santra-wheel=1",
        "width": 520,
        "height": 620,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      },
      {
        "label": "image",
        "title": "Santra image editor",
        "url": "index.html?santra-image-tool=1",
        "width": 824,
        "height": 584,
        "minWidth": 680,
        "minHeight": 540,
        "decorations": false,
        "visible": false,
        "transparent": true
      },
      {
        "label": "video",
        "title": "Santra video editor",
        "url": "index.html?santra-video-tool=1",
        "width": 824,
        "height": 584,
        "minWidth": 680,
        "minHeight": 540,
        "decorations": false,
        "visible": false,
        "transparent": true
      },
      {
        "label": "pdf",
        "title": "Santra PDF tools",
        "url": "index.html?santra-pdf-tool=1",
        "width": 824,
        "height": 584,
        "minWidth": 680,
        "minHeight": 540,
        "decorations": false,
        "visible": false,
        "transparent": true
      },
      {
        "label": "spreadsheet",
        "title": "Santra spreadsheet tools",
        "url": "index.html?santra-sheet-tool=1",
        "width": 824,
        "height": 584,
        "minWidth": 680,
        "minHeight": 540,
        "decorations": false,
        "visible": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: santra-media: http://santra-media.localhost; media-src 'self' blob: santra-media: http://santra-media.localhost; connect-src 'self' ws://127.0.0.1:* santra-media: http://santra-media.localhost; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; worker-src 'self' blob:; frame-src 'self' about:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "../build/icon.png",
      "../build/icon.ico"
    ],
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../licenses/SheetJS-LICENSE.txt": "licenses/SheetJS-LICENSE.txt"
    }
  }
}
